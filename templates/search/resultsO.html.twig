<form action="{{ path('app_search_objet') }}" method="get" class="search-form">
    <input type="text" name="q" placeholder="Rechercher..." value="{{ searchTerm ?? '' }}">
    
    <select name="filter1">
        <option value="">Filtre 1</option>
        <option value="admin" {% if filter1 == 'admin' %}selected{% endif %}>Admin</option>
        <option value="user" {% if filter1 == 'user' %}selected{% endif %}>User</option>
    </select>
    
    <select name="filter2">
        <option value="">Filtre 2</option>
        <option value="active" {% if filter2 == 'active' %}selected{% endif %}>Actif</option>
        <option value="inactive" {% if filter2 == 'inactive' %}selected{% endif %}>Inactif</option>
    </select>
    
    <button type="submit">Rechercher</button>
</form>
<h1>Résultats de la recherche</h1>

{% if results is not empty %}
    <ul>
        {% for obj in results %}
            <li>{{ obj.nom }} - {{ obj.description }}</li>
        {% endfor %}
    </ul>
{% else %}
    <p>Aucun résultat trouvé.</p>
{% endif %}