<form action="{{ path('app_search_objet') }}" method="get" class="search-form">
    <input type="text" name="q" placeholder="Rechercher..." value="{{ searchTerm ?? '' }}">
    
    <select name="filter1">
        <option value="">Filtre 1</option>
        <option value="actif" {% if filter1 == 'actif' %}selected{% endif %}>Actif</option>
        <option value="inactif" {% if filter1 == 'inactif' %}selected{% endif %}>Inactif</option>
    </select>
    
    <select name="filter2">
        <option value="">Filtre 2</option>
        <option value="true" {% if filter2 == 'true' %}selected{% endif %}>À supprimer</option>
        <option value="false" {% if filter2 == 'false' %}selected{% endif %}>À garder</option>
    </select>
    
    <button type="submit">Rechercher</button>
</form>
<h1>Résultats de la recherche</h1>

{% if results is not empty %}
    <ul>
        {% for obj in results %}
            <li>{{ obj.nom }} - {{ obj.description }}</li>
        {% endfor %}
    </ul>
{% else %}
    <p>Aucun résultat trouvé.</p>
{% endif %}