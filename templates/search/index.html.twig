{% extends 'base.html.twig' %}

{% block title %}Hello SearchController!{% endblock %}

{% block body %}
<style>
    .example-wrapper { margin: 1em auto; max-width: 800px; width: 95%; font: 18px/1.5 sans-serif; }
    .example-wrapper code { background: #F5F5F5; padding: 2px 6px; }
</style>

<div class="example-wrapper">
    <h1>Hello {{ controller_name }}! ✅</h1>

    <form action="{{ path('app_search') }}" method="get" class="search-form">
        <input type="text" name="q" placeholder="Rechercher..." value="{{ searchTerm ?? '' }}">
        
        <select name="filter1">
            <option value="">Filtre 1</option>
            <option value="admin" {% if filter1 == 'admin' %}selected{% endif %}>Admin</option>
            <option value="user" {% if filter1 == 'user' %}selected{% endif %}>User</option>
        </select>
        
        <select name="filter2">
            <option value="">Filtre 2</option>
            <option value="active" {% if filter2 == 'active' %}selected{% endif %}>Actif</option>
            <option value="inactive" {% if filter2 == 'inactive' %}selected{% endif %}>Inactif</option>
        </select>
        
        <button type="submit">Rechercher</button>
    </form>

    This friendly message is coming from:
    <ul>
        <li>Your controller at <code>/Users/simon/Desktop/DevWeb/ProjetDevWeb/src/Controller/SearchController.php</code></li>
        <li>Your template at <code>/Users/simon/Desktop/DevWeb/ProjetDevWeb/templates/search/index.html.twig</code></li>
    </ul>
</div>
{% endblock %}
