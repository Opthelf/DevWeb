<form action="{{ path('app_search_user') }}" method="get" class="search-form">
    <input type="text" name="q" placeholder="Rechercher..." value="{{ searchTerm ?? '' }}">
    
    <select name="filter1">
        <option value=""></option>
        <option value="ROLE_VISITEUR" {% if filter1 == 'ROLE_VISITEUR' %}selected{% endif %}>Visiteur</option>
        <option value="ROLE_SIMPLE" {% if filter1 == 'ROLE_SIMPLE' %}selected{% endif %}>Utilisateur Simple</option>
        <option value="ROLE_COMPLEXE" {% if filter1 == 'ROLE_COMPLEXE' %}selected{% endif %}>Utilisateur Complexe</option>
        <option value="ROLE_ADMIN" {% if filter1 == 'ROLE_ADMIN' %}selected{% endif %}>Admin</option>
</select>
    </select>
    
    <select name="filter2">
        <option value=""></option>
        <option value="active" {% if filter2 == 'active' %}selected{% endif %}>Validé</option>
        <option value="inactive" {% if filter2 == 'inactive' %}selected{% endif %}>Non validé</option>
    </select>
    
    <button type="submit">Rechercher</button>
</form>
<h1>Résultats de la recherche</h1>

{% if results is not empty %}
    <ul>
        {% for user in results %}
            <li>{{ user.username }} - {{ user.points }}</li>
        {% endfor %}
    </ul>
{% else %}
    <p>Aucun résultat trouvé.</p>
{% endif %}