{% extends 'base.html.twig' %}

{% block title %}HistoriqueAction index{% endblock %}

{% block body %}
    <h1>HistoriqueAction index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Utilisateur</th>
                <th>Date</th>
                <th>IpAddress</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for historique_action in historique_actions %}
            <tr>
                <td>{{ historique_action.id }}</td>
                <td>{{ historique_action.utilisateur }}</td>
                <td>{{ historique_action.date ? historique_action.date|date('Y-m-d') : '' }}</td>
                <td>{{ historique_action.ipAddress }}</td>
                <td>
                    <a href="{{ path('app_historique_action_show', {'id': historique_action.id}) }}">show</a>
                    <a href="{{ path('app_historique_action_edit', {'id': historique_action.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="5">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_historique_action_new') }}">Create new</a>
{% endblock %}
