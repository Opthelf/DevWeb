{% extends 'base.html.twig' %}

{% block title %}HistoriqueAction{% endblock %}

{% block body %}
    <h1>HistoriqueAction</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ historique_action.id }}</td>
            </tr>
            <tr>
                <th>Utilisateur</th>
                <td>{{ historique_action.utilisateur }}</td>
            </tr>
            <tr>
                <th>Date</th>
                <td>{{ historique_action.date ? historique_action.date|date('Y-m-d') : '' }}</td>
            </tr>
            <tr>
                <th>IpAddress</th>
                <td>{{ historique_action.ipAddress }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_historique_action_index') }}">back to list</a>

    <a href="{{ path('app_historique_action_edit', {'id': historique_action.id}) }}">edit</a>

    {{ include('historique_action/_delete_form.html.twig') }}
{% endblock %}
